APP_ENV=development
LOG_LEVEL=INFO
MODEL_PATH=models/model.joblib

KAGGLE_API_TOKEN=
DATASET_NAME=store-sales
KAGGLE_COMPETITION=store-sales-time-series-forecasting
# Bump this when the source snapshot changes. Used in raw/intermediate S3 paths.
DATASET_VERSION=local-dev

# Local infrastructure credentials. These are example-only development values;
# replace them in your untracked .env before exposing services outside localhost.
MYSQL_DATABASE=zenml
MYSQL_ROOT_PASSWORD=local-dev-mysql
ZENML_DEFAULT_USER_NAME=admin
ZENML_DEFAULT_USER_PASSWORD=local-dev-zenml
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-dev-minio

# ZenML gives this stable artifact name auto-incremented versions: 1, 2, 3, ...
FEATURE_ARTIFACT_NAME=store_sales_features
# Optional S3/MinIO feature-path version. Defaults to DATASET_VERSION.
FEATURE_DATA_VERSION=
# Training accepts 1, 2, ... or aliases v1, v2, ...; empty means latest.
TRAIN_FEATURE_VERSION=
# Optional direct fallback when ZenML artifact metadata is unavailable.
TRAIN_FEATURE_URI=

# Published AutoGluon model artifact. Training uploads the complete predictor
# directory as model.tar.gz and returns MODEL_URI as its final output.
MODEL_NAME=store-sales
MODEL_VERSION=
MODEL_BUCKET=ml-models
MODEL_PACKAGE_ROOT=/tmp/model-publication
MODEL_ARTIFACT_PREFIX=store-sales

# Optional ZenML experiment tracker component name. If set, train/eval steps
# attach MLflow logging to the active stack's experiment tracker.
ZENML_EXPERIMENT_TRACKER_NAME=mlflow_tracker
MLFLOW_EXPERIMENT_TRACKER_NAME=mlflow_tracker
MLFLOW_TRACKING_URI=http://172.17.0.1:5000
MLFLOW_DOCKER_TRACKING_URI=http://172.17.0.1:5000

# Optional explicit object-store writes. ZenML artifacts still use the active stack.
S3_ENDPOINT_URL=http://172.17.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=local-dev-minio
S3_BUCKET=zenml
S3_REGION=us-east-1
RAW_PREFIX=raw
INTERMEDIATE_PREFIX=intermediate
FEATURE_PREFIX=features

ZENML_CONTAINER_ENGINE=docker

# Generic serving image and promotion settings.
SERVING_IMAGE=autogluon-server:1.0.0
MODEL_SHA256=
MODEL_CACHE_DIR=/var/lib/autogluon/model-cache
PRODUCTION_POINTER_URI=s3://ml-models/store-sales/production.json
SERVING_BASE_URL=http://localhost:8000
READY_TIMEOUT_SECONDS=120
PREDICTION_LENGTH=16
AUTOGLUON_PRESETS=high_quality
AUTOGLUON_EVAL_METRIC=RMSLE
AUTOGLUON_TIME_LIMIT=
AUTOGLUON_ENABLE_ENSEMBLE=true
# local_safe avoids memory-heavy deep/foundation models on a 16GB LocalDocker stack.
# Use default to let AutoGluon train the full preset model set.
AUTOGLUON_MODEL_PROFILE=all
QUALITY_GATE_MAX_RMSLE=0.75
QUALITY_GATE_MAX_WQL=
QUALITY_GATE_MAX_RMSE=

SERVING_PUBLISHED_PORT=8000

MODEL_URI=s3://ml-models/store-sales/v1789651715/model.tar.gz
