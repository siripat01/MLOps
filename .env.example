APP_ENV=development
LOG_LEVEL=INFO
MODEL_PATH=models/model.joblib

KAGGLE_API_TOKEN=
DATASET_NAME=store-sales
KAGGLE_COMPETITION=store-sales-time-series-forecasting
# Bump this when the source snapshot changes. Used in raw/intermediate S3 paths.
DATASET_VERSION=local-dev

# ZenML gives this stable artifact name auto-incremented versions: 1, 2, 3, ...
FEATURE_ARTIFACT_NAME=store_sales_features
# Optional S3/MinIO feature-path version. Defaults to DATASET_VERSION.
FEATURE_DATA_VERSION=
# Training accepts 1, 2, ... or aliases v1, v2, ...; empty means latest.
TRAIN_FEATURE_VERSION=5

# Training publishes this stable ZenML model artifact name. Deployment releases
# an existing version instead of training a new model inside the release pipeline.
MODEL_ARTIFACT_NAME=store_sales_model
# Empty means latest model artifact version.
MODEL_ARTIFACT_VERSION=

# Optional explicit object-store writes. ZenML artifacts still use the active stack.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=zenml
S3_REGION=us-east-1
RAW_PREFIX=raw
INTERMEDIATE_PREFIX=intermediate
FEATURE_PREFIX=features

ZENML_CONTAINER_ENGINE=docker

# Release build: model gate -> Bento bundle -> OCI image -> optional registry push.
# Supports {version} and {git_sha}; omit a tag to append the generated version.
BENTO_IMAGE_TAG=mlops-project/store-sales-forecast:{version}
BENTO_PUSH_IMAGE=false
PREDICTION_LENGTH=16
QUALITY_GATE_MAX_RMSLE=0.75
QUALITY_GATE_MAX_WQL=
QUALITY_GATE_MAX_RMSE=

# Runtime: Docker Compose or Kubernetes runs the Bento image directly.
BENTO_RUNTIME_IMAGE=registry.example.com/mlops/store-sales-forecast:replace-me
BENTO_PUBLISHED_PORT=8000
